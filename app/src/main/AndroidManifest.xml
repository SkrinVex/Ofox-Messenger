<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.OfoxMessenger"
        android:manageSpaceActivity=".CacheSettingsActivity"
        tools:targetApi="31">
        <activity
            android:name=".ChatsActivity"
            android:exported="false"
            android:label="@string/title_activity_chats"
            android:theme="@style/Theme.OfoxMessenger" />
        <activity
            android:name=".GroupChatActivity"
            android:exported="false"
            android:label="@string/title_activity_group_chat"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.OfoxMessenger" />
        <activity
            android:name=".games.Flappy"
            android:exported="false"
            android:label="@string/title_activity_flappy"
            android:theme="@style/Theme.OfoxMessenger" />

        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="true" /> <!-- SplashActivity -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.OfoxMessenger">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- MainActivity -->
        <activity
            android:name=".CacheSettingsActivity"
            android:exported="true"
            android:label="@string/manage_storage_label"
            android:theme="@style/Theme.OfoxMessenger"
            android:enabled="true">

            <!-- Этот фильтр делает активити видимой как "Управление хранилищем" -->
            <intent-filter>
                <action android:name="android.intent.action.MANAGE_STORAGE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Добавляем alias для MIUI и других кастомных оболочек -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="com.miui.intent.action.MANAGE_STORAGE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.OfoxMessenger" /> <!-- PostsActivity с intent-фильтрами для deep link'ов -->
        <activity
            android:name=".PostsActivity"
            android:exported="true" />
        <activity
            android:name=".ui.post.PostDetailActivity"
            android:exported="false" />
        <activity android:name=".ProfileEditActivity" />
        <activity android:name=".MainPageActivity" />
        <activity android:name=".ProfileViewActivity" />
        <activity android:name=".ui.common.CrashActivity" />
        <activity android:name=".FriendsActivity" />
        <activity android:name=".ui.viewer.PhotoViewerActivity" />
        <activity
            android:name=".ChatActivity"
            android:windowSoftInputMode="adjustNothing" /> <!-- Регистрация сервиса FCM -->
        <service
            android:name=".PushNotificationService"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service> <!-- Монохромная иконка для уведомлений по умолчанию -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" /> <!-- Цвет иконки (опционально, если хочешь указать дефолтный цвет) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/brand_orange" />
    </application>

</manifest>